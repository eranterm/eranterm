{
  "name": "eraterm",
  "productName": "EranTerm",
  "version": "0.1.14",
  "private": true,
  "description": "Local-first desktop SSH server manager with an approve-before-run AI terminal",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.eraterm.app",
    "files": [
      "*.js",
      "!*.test.js",
      "index.html",
      "debug.html",
      "manual.html",
      "privacy.html",
      "terms.html",
      "style.css",
      "google-oauth.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "eranterm",
      "repo": "eranterm"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  }
}
